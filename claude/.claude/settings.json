{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(git add *)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git checkout -b *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(pip list *)",
      "Bash(pip show *)",
      "Bash(pytest *)",
      "Bash(python --version *)",
      "Bash(ruff *)",
      "Bash(terraform output *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform validate *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh api --method GET *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Bash(dd *)",
      "Bash(git branch -D *)",
      "Bash(git branch -D)",
      "Bash(git checkout .)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git restore .)",
      "Bash(mkfs *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(creds *)"
    ]
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qiE 'creds|security (find|add|delete)-generic-password' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Blocked: credential/keychain access is not permitted\"}}' || true",
            "statusMessage": "Checking for credential access..."
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest"
}
